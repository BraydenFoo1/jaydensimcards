# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Postgres connection string. Production: Neon's *pooled* connection string.
# Local: `npm run db:dev` starts an embedded Postgres on port 54329.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the site. Production: https://jaydensimcards.vercel.app
# Leave unset on Vercel previews (their own URL is used automatically).
BETTER_AUTH_URL=http://localhost:3000

# Optional. Better Auth Infrastructure key for the dash() plugin.
# When empty, dash() is not loaded and no events leave the server.
BETTER_AUTH_API_KEY=

# "smtp" for real email. "outbox" writes emails to .dev-mail/ (local only).
MAIL_TRANSPORT=outbox

# Required when MAIL_TRANSPORT=smtp. For Gmail, SMTP_PASS is a 16-character
# App Password (Google Account -> Security -> App passwords), not your password.
MAIL_FROM="Jayden SIM Cards <jaydensimcards@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
